 src/amd/common/darwin/ac_darwin_drm.h  |   6 +-
 src/amd/common/darwin/ac_darwin_kext.h |   1 +
 src/amd/common/darwin/ac_darwin_mock.c |  20 ++++-
 4 files changed, 108 insertions(+), 27 deletions(-)

diff --git a/src/amd/common/darwin/ac_darwin_drm.c b/src/amd/common/darwin/ac_darwin_drm.c
index 9e35f84..05a5bac 100644
--- a/src/amd/common/darwin/ac_darwin_drm.c
+++ b/src/amd/common/darwin/ac_darwin_drm.c
@@ -26,8 +26,6 @@
 #define ACD_DRM_MAJOR AC_AMDGPU_DRM_MAJOR
 #define ACD_DRM_MINOR AC_AMDGPU_DRM_MINOR
 
-/* amdgpu.ids: 7550,C0 */
-#define ACD_MARKETING_NAME "AMD Radeon RX 9070 XT"
 
 #define ACD_METADATA_MAX 256
 /* How long a submit blocks on a dependency that was never submitted (WAIT_FOR_SUBMIT). */
@@ -61,6 +59,7 @@ struct acd_core {
    int refcount;
    uint32_t minor; /* ABI minor the kernel reported */
    bool shared; /* the process-wide core (false: the private HOST_BO stand-in core) */
+   const struct amdgpu_device *canned; /* the canned device chosen at the handshake */
    struct acd_kext *kext; /* NULL in the HOST_BO stand-in */
    struct amdgpu_va_manager *va_mgr;
    struct util_sync_provider *sync; /* master; every device holds a clone */
@@ -114,9 +113,45 @@ env_is_1(const char *name)
    return v && v[0] == '1';
 }
 
+/* The canned drm-shim entry for the GC version the kernel reports ((maj << 16) | (min << 8) | rev).
+ * RADV_DARWIN_CANNED=<name> overrides it (any name in amdgpu_devices.c). */
+static const struct amdgpu_device *
+canned_for_gc(uint32_t gc_version)
+{
+   const char *name = getenv("RADV_DARWIN_CANNED");
+   if (!name || !name[0]) {
+      switch (gc_version) {
+      case (12u << 16) | (0u << 8) | 1u: name = "gfx1201"; break; /* Navi 48, RX 9070 XT */
+      case (11u << 16) | (0u << 8) | 2u: name = "navi33"; break;  /* Navi 33, RX 7600 (gfx1102) */
+      default:
+         fprintf(stderr, "radv-darwin: no canned device for GC %u.%u.%u (set RADV_DARWIN_CANNED=<name>)\n",
+                 gc_version >> 16, (gc_version >> 8) & 0xff, gc_version & 0xff);
+         return NULL;
+      }
+   }
+   const struct amdgpu_device *d = find_canned(name);
+   if (!d)
+      fprintf(stderr, "radv-darwin: canned device '%s' is not in amdgpu_devices.c\n", name);
+   return d;
+}
+
+/* GB_ADDR_CONFIG as the canned entry recorded it (its mmr_regs triple for that register). */
+static bool
+canned_gb_addr_config(const struct amdgpu_device *d, uint32_t *out)
+{
+   for (uint32_t j = 0; j < d->mmr_reg_count; j++) {
+      const uint32_t *t = &d->mmr_regs[j * 3];
+      if (t[0] == ACD_GB_ADDR_CONFIG_REG && t[1] == 0xffffffffu) {
+         *out = t[2];
+         return true;
+      }
+   }
+   return false;
+}
+
 /* Hello, live checks and the info snapshot; every failure is one clear stderr line. */
 static int
-acd_native_handshake(struct acd_kext *kext, const struct amdgpu_device *canned, uint32_t *minor_out)
+acd_native_handshake(struct acd_kext *kext, const struct amdgpu_device **canned_out, uint32_t *minor_out)
 {
    struct acd_hello h;
    int r = acd_kext_hello(kext, &h);
@@ -142,6 +177,16 @@ acd_native_handshake(struct acd_kext *kext, const struct amdgpu_device *canned,
       return r;
    }
 
+   /* Which GPU: the canned table entry follows the kernel's GC version. */
+   const struct amdgpu_device *canned = canned_for_gc(info.gc_version);
+   if (!canned)
+      return -ENODEV;
+   uint32_t want_gb = 0;
+   if (!canned_gb_addr_config(canned, &want_gb)) {
+      fprintf(stderr, "radv-darwin: canned '%s' has no GB_ADDR_CONFIG\n", canned->name);
+      return -ENODEV;
+   }
+
    /* GB_ADDR_CONFIG: the tiling layout the canned info and S1d's image assume. QueryInfo carries the live value
     * (n48n_info.gb_addr_config); ReadRegs is root-only and refused for a user-application (G4 APP) session, so it is
     * only the fallback for a kernel that left the field 0. */
@@ -153,10 +198,10 @@ acd_native_handshake(struct acd_kext *kext, const struct amdgpu_device *canned,
          return r;
       }
    }
-   if (gb != ACD_GB_ADDR_CONFIG_GFX1201 && !env_is_1("RADV_DARWIN_ALLOW_ADDRCFG")) {
-      fprintf(stderr, "radv-darwin: live GB_ADDR_CONFIG 0x%08x != canned gfx1201 0x%08x (set "
+   if (gb != want_gb && !env_is_1("RADV_DARWIN_ALLOW_ADDRCFG")) {
+      fprintf(stderr, "radv-darwin: live GB_ADDR_CONFIG 0x%08x != canned %s 0x%08x (set "
                       "RADV_DARWIN_ALLOW_ADDRCFG=1 to override)\n",
-              gb, ACD_GB_ADDR_CONFIG_GFX1201);
+              gb, canned->name, want_gb);
       return -ENODEV;
    }
 
@@ -177,11 +222,13 @@ acd_native_handshake(struct acd_kext *kext, const struct amdgpu_device *canned,
    static bool logged;
    if (!logged) {
       logged = true;
-      fprintf(stderr, "radv-darwin: native kext: ABI %u.%u, build %u, VMID %u, max %u IBs/submit, GB_ADDR_CONFIG "
-                      "0x%08x, VRAM %llu MiB visible + %llu MiB hi, GTT cap %llu MiB\n",
-              h.abi, h.minor, h.build, h.vmid, h.max_ibs, gb, (unsigned long long)(info.vram_vis_total >> 20),
+      fprintf(stderr, "radv-darwin: native kext: ABI %u.%u, build %u, GC %u.%u.%u -> canned %s, VMID %u, max %u "
+                      "IBs/submit, GB_ADDR_CONFIG 0x%08x, VRAM %llu MiB visible + %llu MiB hi, GTT cap %llu MiB\n",
+              h.abi, h.minor, h.build, info.gc_version >> 16, (info.gc_version >> 8) & 0xff, info.gc_version & 0xff,
+              canned->name, h.vmid, h.max_ibs, gb, (unsigned long long)(info.vram_vis_total >> 20),
               (unsigned long long)(info.vram_hi_total >> 20), (unsigned long long)(info.gtt_cap >> 20));
    }
+   *canned_out = canned;
    return 0;
 }
 
@@ -193,10 +240,13 @@ acd_device_kext(acd_device_handle dev, uint32_t *abi_minor)
    return dev->core->kext;
 }
 
-/* Builds the core: connection (unless the HOST_BO stand-in), handshake, VA manager, master provider. */
+/* Builds the core: connection (unless the HOST_BO stand-in), handshake, VA manager, master provider.
+ * With the kext the handshake picks the canned device from the live GC version; the HOST_BO
+ * stand-in has no kernel to ask and takes RADV_DARWIN_CANNED, else gfx1201. */
 static int
-acd_core_create(const struct amdgpu_device *canned, bool host_bo, struct acd_core **out)
+acd_core_create(bool host_bo, struct acd_core **out)
 {
+   const struct amdgpu_device *canned = NULL;
    struct acd_core *c = calloc(1, sizeof(*c));
    if (!c)
       return -ENOMEM;
@@ -206,7 +256,7 @@ acd_core_create(const struct amdgpu_device *canned, bool host_bo, struct acd_cor
    if (!host_bo) {
       int r = acd_kext_open(&c->kext);
       if (r == 0)
-         r = acd_native_handshake(c->kext, canned, &c->minor);
+         r = acd_native_handshake(c->kext, &canned, &c->minor);
       if (r) {
          acd_kext_destroy(c->kext);
          pthread_mutex_destroy(&c->bo_lock);
@@ -215,6 +265,20 @@ acd_core_create(const struct amdgpu_device *canned, bool host_bo, struct acd_cor
       }
    }
 
+   if (host_bo) {
+      const char *name = getenv("RADV_DARWIN_CANNED");
+      if (!name || !name[0])
+         name = "gfx1201";
+      canned = find_canned(name);
+      if (!canned) {
+         fprintf(stderr, "radv-darwin: canned device '%s' is not in amdgpu_devices.c\n", name);
+         pthread_mutex_destroy(&c->bo_lock);
+         free(c);
+         return -ENODEV;
+      }
+   }
+   c->canned = canned;
+
    const struct acd_sync_backend be = {.wait_seq = acd_backend_wait_seq, .ctx = c->kext};
    c->sync = acd_sync_provider_create(c->kext ? &be : NULL);
    c->va_mgr = amdgpu_va_manager_alloc();
@@ -229,7 +293,7 @@ acd_core_create(const struct amdgpu_device *canned, bool host_bo, struct acd_cor
    }
 
    const struct drm_amdgpu_info_device *di = &canned->dev;
-   /* gfx12: RADV needs half of the VA range reserved for PRT, as on Linux. */
+   /* gfx11 and gfx12: RADV needs half of the VA range reserved for PRT, as on Linux (amdgpu_device_initialize). */
    amdgpu_va_manager_init2(c->va_mgr, di->virtual_address_offset, di->virtual_address_max, di->high_va_offset,
                            di->high_va_max, di->virtual_address_alignment, AMDGPU_VA_MGR_RESERVE_HALF_VA_FOR_PRT);
    *out = c;
@@ -257,25 +321,19 @@ acd_device_initialize(uint32_t *drm_major, uint32_t *drm_minor, acd_device_handl
    if (!dev)
       return -ENOMEM;
 
-   dev->canned = find_canned("gfx1201");
-   if (!dev->canned) {
-      free(dev);
-      return -ENODEV;
-   }
-
    const bool mock = env_is_1("RADV_DARWIN_MOCK");
    dev->host_bo = env_is_1("RADV_DARWIN_HOST_BO") && !mock;
 
    int r = 0;
    if (dev->host_bo) {
-      r = acd_core_create(dev->canned, true, &dev->core); /* private, no kext */
+      r = acd_core_create(true, &dev->core); /* private, no kext */
    } else {
       pthread_mutex_lock(&g_core_lock);
       if (g_core) {
          g_core->refcount++;
          dev->core = g_core;
       } else {
-         r = acd_core_create(dev->canned, false, &g_core);
+         r = acd_core_create(false, &g_core);
          if (r == 0) {
             g_core->shared = true;
             dev->core = g_core;
@@ -287,6 +345,7 @@ acd_device_initialize(uint32_t *drm_major, uint32_t *drm_minor, acd_device_handl
       free(dev);
       return r;
    }
+   dev->canned = dev->core->canned;
 
    dev->sync = dev->core->sync->clone(dev->core->sync);
    if (!dev->sync) {
@@ -331,7 +390,12 @@ acd_device_get_sync_provider(acd_device_handle dev)
 const char *
 acd_get_marketing_name(acd_device_handle dev)
 {
-   return ACD_MARKETING_NAME;
+   /* amdgpu.ids names for the canned devices: 7550,C0 and 7480,CF. */
+   switch (dev->canned->dev.device_id) {
+   case 0x7550: return "AMD Radeon RX 9070 XT";
+   case 0x7480: return "AMD Radeon RX 7600";
+   default: return "AMD Radeon Graphics";
+   }
 }
 
